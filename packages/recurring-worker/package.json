{
  "name": "@todu/recurring-worker",
  "version": "0.2.1",
  "description": "Standalone recurring automation worker plugin for todu daemon",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node generate-version.mjs",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "node generate-version.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@todu/core": "^0.28.0",
    "@todu/engine": "^0.24.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evcraddock/todu.git",
    "directory": "packages/recurring-worker"
  },
  "license": "MIT",
  "keywords": [
    "todu",
    "daemon",
    "worker",
    "recurring",
    "plugin"
  ],
  "engines": {
    "node": ">=20"
  }
}
