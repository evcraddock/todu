{
  "name": "@todu/daemon",
  "version": "0.28.2",
  "description": "Daemon runtime foundation for todu",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "todu-daemon": "dist/entrypoint.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "dev": "tsx src/entrypoint.ts"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@automerge/automerge-repo": "2.5.6",
    "@automerge/automerge-repo-storage-nodefs": "2.5.6",
    "@todu/core": "^0.28.0",
    "@todu/engine": "^0.24.6",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evcraddock/todu.git",
    "directory": "packages/daemon"
  },
  "license": "MIT",
  "keywords": [
    "todu",
    "daemon",
    "runtime"
  ],
  "engines": {
    "node": ">=20"
  }
}
