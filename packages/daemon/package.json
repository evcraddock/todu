{
  "name": "@todu/daemon",
  "version": "0.23.2",
  "description": "Daemon runtime foundation for todu",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "todu-daemon": "dist/entrypoint.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "typecheck": "tsgo -p tsconfig.build.json --noEmit",
    "dev": "tsx src/entrypoint.ts"
  },
  "dependencies": {
    "@automerge/automerge-repo": "2.5.6",
    "@todu/core": "*",
    "@todu/engine": "*",
    "yaml": "^2.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evcraddock/todu.git",
    "directory": "packages/daemon"
  },
  "license": "MIT",
  "keywords": [
    "todu",
    "daemon",
    "runtime"
  ],
  "engines": {
    "node": ">=20"
  }
}
