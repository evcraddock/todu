{
  "name": "@todu/electron",
  "version": "0.25.0",
  "description": "todu desktop app — local-first task management",
  "desktopName": "todu.desktop",
  "author": {
    "name": "evcraddock",
    "email": "erik@craddock.org"
  },
  "homepage": "https://github.com/evcraddock/todu",
  "private": true,
  "type": "module",
  "main": "./dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "test:layout": "electron scripts/test-detail-layout.cjs",
    "build": "npm --prefix ../../ run build --workspace=@todu/daemon && electron-vite build && node scripts/bundle-daemon.mjs",
    "preview": "electron-vite preview",
    "dist": "electron-builder --config electron-builder.yml",
    "dist:linux": "electron-builder --config electron-builder.yml --linux",
    "dist:linux:dir": "electron-builder --config electron-builder.yml --linux dir",
    "dist:mac": "electron-builder --config electron-builder.yml --mac --arm64",
    "dist:mac:dir": "electron-builder --config electron-builder.yml --mac dir --arm64",
    "dist:win": "electron-builder --config electron-builder.yml --win",
    "dist:win:dir": "electron-builder --config electron-builder.yml --win dir",
    "validate:daemon-bundle:linux": "node scripts/validate-daemon-bundle.mjs --unpacked-dir ../../dist/installers/linux-unpacked",
    "validate:daemon-bundle:mac": "node scripts/validate-daemon-bundle.mjs --app-bundle ../../dist/installers/mac-arm64/todu.app",
    "validate:daemon-bundle:win": "node scripts/validate-daemon-bundle.mjs --unpacked-dir ../../dist/installers/win-unpacked",
    "generate:icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@tanstack/react-query": "^5.104.5",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@todu/core": "*",
    "@todu/engine": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tiptap-markdown": "0.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5"
  }
}
