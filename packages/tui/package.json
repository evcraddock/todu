{
  "name": "@todu/tui",
  "version": "0.26.0",
  "description": "TUI for todu task management — keyboard-first task workflows in the terminal",
  "type": "module",
  "bin": {
    "todu-tui": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node generate-version.mjs",
    "build": "tsgo -p tsconfig.build.json && chmod +x dist/index.js",
    "prepack": "npm run build",
    "test": "cd ../.. && vitest run $(find packages/tui/src \\( -name '*.test.ts' -o -name '*.test.tsx' \\))",
    "typecheck": "tsgo -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@todu/core": "*",
    "ink": "^7.1.0",
    "react": "^19.2.0",
    "react-devtools-core": "^7.0.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evcraddock/todu.git",
    "directory": "packages/tui"
  },
  "license": "MIT",
  "keywords": [
    "todu",
    "task-management",
    "tui",
    "terminal",
    "productivity"
  ],
  "engines": {
    "node": ">=22"
  }
}
