{
  "name": "todu",
  "version": "0.26.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:engine && npm run build:recurring-worker && npm run build:daemon && npm run build:cli && npm run build:tui",
    "build:core": "npm run --workspace=packages/core build",
    "build:engine": "npm run --workspace=packages/engine build",
    "build:recurring-worker": "npm run --workspace=packages/recurring-worker build",
    "build:daemon": "npm run --workspace=packages/daemon build",
    "build:cli": "npm run --workspace=packages/cli build",
    "build:tui": "npm run --workspace=packages/tui build",
    "test": "vitest run",
    "test:all": "vitest run --config vitest.all.config.ts",
    "test:integration": "vitest run --config vitest.all.config.ts .integration.test.",
    "test:sync-server-integration": "vitest run --config vitest.all.config.ts packages/daemon/src/events-parity.integration.test.ts packages/daemon/src/join-safety.integration.test.ts packages/engine/src/remote-sync.integration.test.ts packages/engine/src/sync.integration.test.ts",
    "test:daemon-shutdown-integration": "vitest run --config vitest.all.config.ts packages/daemon/src/shutdown.integration.test.ts packages/daemon/src/transport.integration.test.ts packages/daemon/src/rpc.integration.test.ts packages/daemon/src/process.integration.test.ts",
    "test:conformance": "vitest run --config vitest.all.config.ts packages/daemon/src/protocol-conformance.integration.test.ts",
    "test:storage-stability": "node scripts/test-storage-stability.mjs",
    "test:watch": "vitest",
    "changeset": "changeset",
    "changeset:infer": "node scripts/create-inferred-changeset.mjs",
    "release": "node scripts/create-inferred-changeset.mjs",
    "version-packages": "changeset version && node scripts/generate-package-versions.mjs && npm install --package-lock-only --ignore-scripts",
    "release-packages": "npm run build && changeset publish",
    "postinstall": "node packages/engine/scripts/patch-automerge-repo.mjs",
    "check": "biome check --write --error-on-warnings . && npm run typecheck",
    "check:ci": "biome check --error-on-warnings . && npm run typecheck",
    "typecheck": "npm run --workspace=packages/core build && npm run --workspace=packages/engine build && npm run --workspace=packages/recurring-worker typecheck && npm run --workspace=packages/daemon build && npm run --workspace=packages/cli typecheck && npm run --workspace=packages/tui typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@changesets/cli": "^3.0.3",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "electron-builder": "^26.18.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "@tanstack/react-query": "^5.104.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
