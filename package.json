{
  "name": "todu",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:engine && npm run build:daemon && npm run build:cli",
    "build:core": "npm run --workspace=packages/core build",
    "build:engine": "npm run --workspace=packages/engine build",
    "build:daemon": "npm run --workspace=packages/daemon build",
    "build:cli": "npm run --workspace=packages/cli build",
    "test": "vitest run",
    "test:conformance": "vitest run packages/daemon/src/protocol-conformance.test.ts",
    "test:storage-stability": "node scripts/test-storage-stability.mjs",
    "test:watch": "vitest",
    "check": "biome check --write --error-on-warnings . && npm run typecheck",
    "check:ci": "biome check --error-on-warnings . && npm run typecheck",
    "typecheck": "npm run --workspace=packages/core build && npm run --workspace=packages/engine build && npm run --workspace=packages/daemon typecheck && npm run --workspace=packages/cli typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260215.1",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "electron": "^40.4.1",
    "electron-builder": "^26.7.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@automerge/automerge": "^3.2.4",
    "@tanstack/react-query": "^5.90.21"
  }
}
