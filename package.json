{
  "name": "todu",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:engine && npm run build:cli",
    "build:core": "npm run --workspace=packages/core build",
    "build:engine": "npm run --workspace=packages/engine build",
    "build:cli": "npm run --workspace=packages/cli build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check --write --error-on-warnings . && tsgo --noEmit",
    "check:ci": "biome check --error-on-warnings . && tsgo --noEmit",
    "typecheck": "tsgo --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.2.1",
    "@typescript/native-preview": "^7.0.0-dev",
    "husky": "^9.1.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
